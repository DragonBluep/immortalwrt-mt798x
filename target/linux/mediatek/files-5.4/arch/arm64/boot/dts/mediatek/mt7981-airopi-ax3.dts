/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/mt65xx.h>

#include "mt7981.dtsi"

/ {
	compatible = "airopi,ax3", "mediatek,mt7981";
	model = "AiroPi AX3";

	aliases {
		led-boot = &led_status;
		led-failsafe = &led_status;
		led-running = &led_status;
		led-upgrade = &led_status;
		serial0 = &uart0;
	};

	chosen {
		bootargs = "root=PARTLABEL=rootfs rootwait rootfstype=squashfs,f2fs";
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-names = "default";
		pinctrl-0 = <&keys_pins>;

		button-reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
		};
	};

	gpio-leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&leds_pins>;

		led_status: led-0 {
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_STATUS;
			gpios = <&pio 9 GPIO_ACTIVE_LOW>;
			label = "blue:status";
		};
	};

	memory@40000000 {
		reg = <0 0x40000000 0 0x40000000>;
		device_type = "memory";
	};

	reg_fan: regulator-fan {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&pio 5 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&fan_power_pins>;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "fan_power";
	};

	/* broken regulator, wrong voltage */
	reg_vbus: regulator-vbus {
		compatible = "regulator-fixed";
		enable-active-high;
		gpios = <&pio 14 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_vbus_pins>;
		regulator-boot-on;
		regulator-max-microvolt = <5000000>;
		regulator-min-microvolt = <5000000>;
		regulator-name = "usb_vbus";
	};

	reg_vmmc: regulator-vmmc {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "mmc_power";
	};

	reg_vqmmc: regulator-vqmmc {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "mmc_io";
	};

	reg_vusb33: regulator-vusb33 {
		compatible = "regulator-fixed";
		regulator-always-on;
		regulator-max-microvolt = <3300000>;
		regulator-min-microvolt = <3300000>;
		regulator-name = "usb_io";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		ramoops@42ff0000 {
			compatible = "ramoops";
			reg = <0 0x42ff0000 0 0x00010000>;
			console-size = <0x8000>;
			record-size = <0x2000>;
		};
	};
};

&eth {
	pinctrl-names = "default";
	pinctrl-0 = <&mdio_pins>;
	status = "okay";

	mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		phy-handle = <&ext_2p5g_phy>;
	};

	mac@1 {
		compatible = "mediatek,eth-mac";
		reg = <1>;
		phy-mode = "gmii";
		phy-handle = <&int_gbe_phy>;
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;

		int_gbe_phy: ethernet-phy@0 {
			compatible = "ethernet-phy-id03a2.9461";
			reg = <0>;
			nvmem-cells = <&phy_calibration>;
			nvmem-cell-names = "phy-cal-data";
			phy-mode = "gmii";
			// phy-is-integrated;
			pinctrl-names = "gbe-led";
			pinctrl-0 = <&gbe_leds_pins>;
		};

		ext_2p5g_phy: ethernet-phy@7 {
			compatible = "ethernet-phy-ieee802.3-c45";
			reg = <7>;
			interrupt-parent = <&pio>;
			interrupts = <38 IRQ_TYPE_LEVEL_LOW>;
			pinctrl-names = "default";
			pinctrl-0 = <&ephy_2p5g_pins>;
			realtek,aldps-enable;
			reset-assert-us = <20000>;
			reset-deassert-us = <100000>;
			reset-gpios = <&pio 39 GPIO_ACTIVE_LOW>;
		};

	};
};
/*
&fan {
	fan-supply = <&reg_fan>;
	interrupt-parent = <&pio>;
	interrupts = <11 IRQ_TYPE_EDGE_RISING>;
	pinctrl-names = "default";
	pinctrl-0 = <&fan_tach_pins>;
	pwms = <&pwm 2 40000 0>;
	status = "okay";
};
*/
&hnat {
	mtketh-wan = "eth0";
	mtketh-lan = "eth1";
	mtketh-max-gmac = <2>;
	ext-devices-prefix = "usb", "wwan";
	status = "okay";
};

&mmc0 {
	bus-width = <4>;
	cap-sd-highspeed;
	disable-wp;
	max-frequency = <52000000>;
	no-1-8-v;
	no-mmc;
	no-sdio;
	non-removable; /* workaround for hardware defect */
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc_pins>;
	pinctrl-1 = <&mmc_pins>;
	vmmc-supply = <&reg_vmmc>;
	vqmmc-supply = <&reg_vqmmc>;
	status = "okay";
};

&pio {
	ephy_2p5g_pins: ephy-2p5g-pins {
		conf-int {
			input-enable;
			input-schmitt-enable;
			drive-strength = <MTK_DRIVE_2mA>;
			mediatek,pull-up-adv = <0>;
			pins = "GBE_INT";
		};

		conf-rst {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "GBE_RESET";
		};
	};

	fan_power_pins: fan-power-pins {
		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <0>;
			pins = "JTAG_JTDI";
		};
	};

	fan_tach_pins: fan-tach-pins {
		conf {
			input-enable;
			input-schmitt-enable;
			drive-strength = <MTK_DRIVE_2mA>;
			mediatek,pull-up-adv = <1>;
			pins = "WO_JTAG_JTMS";
		};
	};

	gbe_leds_pins: gbe-leds-pins {
		mux {
			function = "led";
			groups = "gbe_led0", "gbe_led1";
		};

		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "JTAG_JTRST_N", "WO_JTAG_JTRST_N";
		};
	};

	keys_pins: keys-pins {
		conf {
			input-enable;
			input-schmitt-enable;
			drive-strength = <MTK_DRIVE_2mA>;
			mediatek,pull-up-adv = <0>;
			pins = "GPIO_RESET";
		};
	};

	leds_pins: leds-pins {
		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "WO_JTAG_JTDO";
		};
	};

	mdio_pins: mdc-mdio-pins {
		mux {
			function = "eth";
			groups = "smi_mdc_mdio";
		};

		conf-clk {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "SMI_MDC";
		};

		conf-io {
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "SMI_MDIO";
		};
	};

	mmc_pins: mmc-pins {
		mux {
			function = "flash";
			groups = "emmc_4";
		};

		conf-cmd-dat {
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <1>;
			pins = "SPI0_CLK", "SPI0_MOSI", "SPI0_MISO",
			       "SPI0_CS", "SPI1_MISO";
		};

		conf-clk {
			output-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-down-adv = <2>;
			pins = "SPI1_CS";
		};
	};

	pwm2_pins: pwm2-pins {
		mux {
			function = "pwm";
			groups = "pwm2";
		};

		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <0>;
			pins = "JTAG_JTCLK";
		};
	};

	spi2_pins: spi2-pins {
		mux {
			function = "spi";
			groups = "spi2", "spi2_wp_hold";
		};

		conf-clk-cs {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "SPI2_CLK", "SPI2_CS";
		};

		conf-dat {
			input-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "SPI2_MOSI", "SPI2_MISO", "SPI2_HOLD", "SPI2_WP";
		};
	};

	uart0_pins: uart0-pins {
		mux {
			function = "uart";
			groups = "uart0";
		};

		conf-rx {
			input-enable;
			input-schmitt-enable;
			drive-strength = <MTK_DRIVE_2mA>;
			mediatek,pull-up-adv = <0>;
			pins = "UART0_RXD";
		};

		conf-tx {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "UART0_TXD";
		};
	};

	usb_vbus_pins: usb-vbus-pins {
		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_8mA>;
			mediatek,pull-up-adv = <0>;
			pins = "USB_VBUS";
		};
	};

	wifi_leds_pins: wifi-leds-pins {
		mux {
			function = "led";
			groups = "wf2g_led1", "wf5g_led1";
		};

		conf {
			output-enable;
			drive-strength = <MTK_DRIVE_4mA>;
			mediatek,pull-up-adv = <0>;
			pins = "PCIE_CLK_REQ", "PCIE_WAKE_N";
		};
	};
};

&pwm {
	pinctrl-names = "default";
	pinctrl-0 = <&pwm2_pins>;
};

&spi2 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi2_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		m25p,fast-read;
		spi-max-frequency = <52000000>;
		spi-rx-bus-width = <4>;
		spi-tx-bus-width = <4>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "bl2";
				reg = <0x000000 0x040000>;
			};

			partition@40000 {
				label = "u-boot-env";
				reg = <0x040000 0x010000>;
			};

			partition@50000 {
				label = "factory";
				reg = <0x050000 0x0b0000>;
			};

			partition@100000 {
				label = "fip";
				reg = <0x100000 0x080000>;
			};

			partition@180000 {
				label = "firmware";
				reg = <0x180000 0x000000>;
			};
		};
	};
};

&uart0 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart0_pins>;
	status = "okay";
};

&wbsys {
	pinctrl-names = "default";
	pinctrl-0 = <&wifi_leds_pins>;
};

&xhci {
	phys = <&u2port0 PHY_TYPE_USB2>,
	       <&u3port0 PHY_TYPE_USB3>;
	vbus-supply = <&reg_vbus>;
	vusb33-supply = <&reg_vusb33>;
	status = "okay";
};
